# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# browser-automation scratch (Playwright MCP snapshots, console logs, screenshots)
/.playwright-mcp/

# full-stack testing pipeline artifacts (screenshots, reports) — local-only
/test-artifacts/

# next.js
/.next/
/out/
# Finder-duplicated build folders (e.g. ".next 2", ".next 3")
/.next [0-9]*/
/out [0-9]*/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/setting.local.json
.codebase-memory/

# design-track
docs/lombakita-ui-guide/

# separate version control
/.claude
/CLAUDE.md
/docs/
/README.md
/AGENTS.md
/src/worker/README.md