{
  "name": "lombakitaid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --ignore-unknown --write \"src/**/*.{ts,tsx,css}\" \".github/workflows/*.{yml,yaml}\" README.md package.json tsconfig.json eslint.config.mjs next.config.ts postcss.config.mjs vitest.config.ts drizzle.config.ts .prettierrc.json",
    "format:check": "prettier --ignore-unknown --check \"src/**/*.{ts,tsx,css}\" \".github/workflows/*.{yml,yaml}\" README.md package.json tsconfig.json eslint.config.mjs next.config.ts postcss.config.mjs vitest.config.ts drizzle.config.ts .prettierrc.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "connectors:status": "node --import tsx src/server/scripts/connectors-status.ts",
    "connectors:status:live": "node --import tsx src/server/scripts/connectors-status.ts --live",
    "connectors:status:worker": "node --import tsx src/server/scripts/connectors-status.ts --live --worker",
    "worker:start": "RUNTIME_NAME=worker node --import tsx src/worker/index.ts",
    "jobs:probe:enqueue": "node --import tsx src/server/scripts/enqueue-probe-job.ts",
    "db:migrate:guarded": "node --import tsx src/server/scripts/migration-guard.ts && drizzle-kit migrate",
    "env:check:web": "node --import tsx src/server/scripts/validate-env.ts --runtime=web",
    "env:check:worker": "node --import tsx src/server/scripts/validate-env.ts --runtime=worker",
    "env:check": "node --import tsx src/server/scripts/validate-env.ts --runtime=web",
    "verify:concurrency": "for f in scripts/verify-owner-cap-concurrency.ts scripts/concurrency/*.ts; do case \"$f\" in *harness.ts) continue ;; esac; echo \"→ $f\"; node --import tsx \"$f\" || exit 1; done",
    "verify:finance": "node --import tsx scripts/finance/verify-payment-ledger.ts",
    "verify:contrast-selftest": "node scripts/testing/contrast-audit-selftest.mjs",
    "verify:guard-probes": "node scripts/testing/probes/config-gates.mjs",
    "verify:audit-probes": "node scripts/testing/probes/browser-audit-refusals.mjs",
    "verify:deploy-env": "node --import tsx src/server/scripts/verify-deploy-env.ts",
    "verify:deploy-smoke": "node scripts/deploy/smoke.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.1",
    "@aws-sdk/client-s3": "^3.894.0",
    "@aws-sdk/s3-request-presigner": "^3.1024.0",
    "@sentry/nextjs": "^10.56.0",
    "@sentry/node": "^10.56.0",
    "bullmq": "^5.73.5",
    "drizzle-orm": "^0.44.6",
    "ioredis": "^5.8.1",
    "meilisearch": "^0.54.0",
    "next": "16.2.2",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
